{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-harness.dev/schema/decision-policy.v1.schema.json",
  "title": "Agentic Harness DecisionPolicy v1",
  "type": "object",
  "required": [
    "format_version",
    "kind",
    "id",
    "revision",
    "applies_to",
    "risk",
    "evidence",
    "confidence",
    "dispositions",
    "consequential_action",
    "invariants"
  ],
  "properties": {
    "format_version": {
      "const": 1
    },
    "kind": {
      "const": "decision-policy"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "applies_to": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "risk": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "evidence": {
      "type": "object",
      "required": [
        "minimum_coverage",
        "on_missing_required"
      ],
      "properties": {
        "minimum_coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "on_missing_required": {
          "enum": [
            "review",
            "abstain",
            "reject"
          ]
        }
      },
      "additionalProperties": true
    },
    "confidence": {
      "type": "object",
      "required": [
        "calibration_required",
        "minimum_provider_confidence",
        "minimum_decision_certainty"
      ],
      "properties": {
        "calibration_required": {
          "type": "boolean"
        },
        "minimum_provider_confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "minimum_decision_certainty": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": true
    },
    "dispositions": {
      "type": "object",
      "required": [
        "success",
        "low_confidence",
        "insufficient_evidence",
        "conflict",
        "provider_failure"
      ],
      "properties": {
        "success": {
          "enum": [
            "accepted",
            "review",
            "abstained",
            "rejected"
          ]
        },
        "low_confidence": {
          "enum": [
            "review",
            "abstained",
            "rejected"
          ]
        },
        "insufficient_evidence": {
          "enum": [
            "review",
            "abstained",
            "rejected"
          ]
        },
        "conflict": {
          "enum": [
            "review",
            "abstained",
            "rejected"
          ]
        },
        "provider_failure": {
          "enum": [
            "review",
            "abstained",
            "rejected"
          ]
        }
      },
      "additionalProperties": true
    },
    "consequential_action": {
      "enum": [
        "forbidden",
        "review-required",
        "separate-authorization-required"
      ]
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "enforcement"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "enforcement": {
            "const": "deterministic"
          }
        },
        "additionalProperties": true
      }
    },
    "human_review": {
      "type": "object",
      "properties": {
        "required": {
          "type": "boolean"
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
