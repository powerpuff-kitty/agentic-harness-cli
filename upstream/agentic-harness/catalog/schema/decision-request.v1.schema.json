{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-harness.dev/schema/decision-request.v1.schema.json",
  "title": "Agentic Harness DecisionRequest v1",
  "type": "object",
  "required": [
    "format_version",
    "kind",
    "request_id",
    "state",
    "questions",
    "mode"
  ],
  "properties": {
    "format_version": {
      "const": 1
    },
    "kind": {
      "const": "decision-request"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "type": "object",
      "required": [
        "schema_id",
        "schema_version",
        "fingerprint"
      ],
      "properties": {
        "schema_id": {
          "type": "string",
          "minLength": 1
        },
        "schema_version": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "integer",
              "minimum": 1
            }
          ]
        },
        "fingerprint": {
          "type": "string",
          "minLength": 8
        },
        "snapshot_ref": {
          "type": "string",
          "minLength": 1
        },
        "payload": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "spec_id",
          "spec_revision"
        ],
        "properties": {
          "spec_id": {
            "type": "string",
            "minLength": 1
          },
          "spec_revision": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": true
      }
    },
    "mode": {
      "enum": [
        "live",
        "shadow",
        "replay",
        "evaluation"
      ]
    },
    "provider_hint": {
      "type": "string",
      "minLength": 1
    },
    "budget": {
      "type": "object",
      "properties": {
        "timeout_ms": {
          "type": "integer",
          "minimum": 1
        },
        "max_cost": {
          "type": "number",
          "minimum": 0
        },
        "max_parallel": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
