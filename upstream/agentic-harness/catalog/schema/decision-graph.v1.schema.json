{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-harness.dev/schema/decision-graph.v1.schema.json",
  "title": "Agentic Harness DecisionGraph v1",
  "type": "object",
  "required": [
    "format_version",
    "kind",
    "id",
    "revision",
    "nodes"
  ],
  "properties": {
    "format_version": {
      "const": 1
    },
    "kind": {
      "const": "decision-graph"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._/-]*$",
      "minLength": 3
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "spec_id",
          "spec_revision",
          "depends_on"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._/-]*$"
          },
          "spec_id": {
            "type": "string",
            "minLength": 1
          },
          "spec_revision": {
            "type": "integer",
            "minimum": 1
          },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": true
      }
    },
    "reducers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "inputs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "const": "deterministic"
          },
          "inputs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "output": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
